# 이 파일을 .env 로 복사해서 쓰세요.   macOS/Linux: cp .env.example .env   Windows: copy .env.example .env
# .env 는 저장소에 올라가지 않습니다(.gitignore). 비밀번호를 채팅·스크린샷에 올리지 마세요.
# 서버(uvicorn)와 마이그레이션(alembic)이 저장소 루트의 .env 를 자동으로 읽습니다.
# 터미널·클러스터에 같은 이름의 환경 변수가 이미 있으면 그 값이 우선합니다.

# --- DB (Postgres) ---
# 쓰기 계정 주소. 비워 두면 DB 없이 동작합니다(내보내기만 쓸 때).
# 로컬 개발: docker-compose.dev.yml로 띄운 Postgres에 맞춘 값(Windows+Docker Desktop에서는 localhost보다 127.0.0.1이 안정적이었습니다)
SHEET_FORGE_DATABASE_URL=postgresql://postgres:dev@127.0.0.1:5432/sheet_forge
# 내보내기용 읽기 전용 계정 주소. 비워 두면 위 주소를 씁니다.
# SHEET_FORGE_DATABASE_URL_RO=
# SHEET_FORGE_DB_POOL_SIZE=5
# SHEET_FORGE_DB_CONNECT_TIMEOUT_S=3

# DB 통합 테스트 전용 주소. 테스트가 테이블을 만들고 지우므로 개발 DB와 다른 DB를 쓰는 것을 권장합니다.
# SHEET_FORGE_TEST_DATABASE_URL=postgresql://postgres:dev@127.0.0.1:5432/sheet_forge_test

# --- 이미지 저장소 (MinIO) ---
# 사진 API와 작업자에 필요합니다. 호스트:포트(S3 API 포트는 보통 9000, 다르면 고치세요). 실제 IP·키는 .env에만 적습니다.
# SHEET_FORGE_MINIO_ENDPOINT=<MinIO 서버 IP>:9000
# SHEET_FORGE_MINIO_ACCESS_KEY=
# SHEET_FORGE_MINIO_SECRET_KEY=
# SHEET_FORGE_MINIO_BUCKET=sheet-forge
# TLS(https)로 접속하면 true
# SHEET_FORGE_MINIO_SECURE=false
# 작업자가 새 작업을 확인하는 간격(초)
# SHEET_FORGE_WORKER_POLL_S=2

# --- 일반 ---
# 인증 전 단일 소유자 값(바꿀 일은 거의 없습니다)
# SHEET_FORGE_DEFAULT_OWNER_ID=owner_default
# 웹이 다른 주소에서 API를 부를 때 허용할 Origin(쉼표로 구분). 예: http://localhost:3000
# SHEET_FORGE_CORS_ORIGINS=http://localhost:3000

# --- 제한(기본값을 바꿀 때만) ---
# SHEET_FORGE_MAX_PROBLEMS=200
# SHEET_FORGE_MAX_FIGURES=200
# SHEET_FORGE_MAX_IMAGE_BYTES=5242880
# SHEET_FORGE_MAX_IMAGE_PX=8000
# SHEET_FORGE_MAX_BODY_BYTES=33554432
# SHEET_FORGE_MAX_PHOTO_BYTES=20971520
# SHEET_FORGE_MAX_PAGES_PER_EXAM=30

# --- 인식(B5) ---
# fake(기본): 가짜 결과. real: 실제 보정·분할·읽기·그림 정리(real이면 아래 키가 필요합니다)
# SHEET_FORGE_RECOGNITION_ENGINE=fake
# 외부 LLM 키. 비밀이므로 .env 또는 클러스터 Secret에만 적습니다(채팅·스크린샷 금지)
# SHEET_FORGE_LLM_API_KEY=
# SHEET_FORGE_SEGMENT_MODEL=gemini-3.5-flash-lite
# SHEET_FORGE_READ_MODEL=gemini-3.5-flash-lite
# SHEET_FORGE_REREAD_MODEL=gemini-3.8-flash
# SHEET_FORGE_LLM_TIMEOUT_S=30
# SHEET_FORGE_SEGMENT_IMAGE_LONG_SIDE=1500
# 하루 읽기 한도(한국 시간 기준, 다시 읽기는 2배)
# SHEET_FORGE_DAILY_READ_LIMIT=200
